/* MONSOON v0.4 — glossy 2000s console look. Colours come from --a (accent), --bt/--bm (backdrop), --g (glow). */
*{box-sizing:border-box;margin:0;padding:0}
:root{--a:255 255 255;--g:1;--gloss:linear-gradient(180deg,#ffffff4d 0,#ffffff12 49%,#0000002e 50%,#ffffff12 100%)}
html{font-size:calc(1.85vh*var(--s,1))}
body{height:100vh;overflow:hidden;cursor:none;user-select:none;color:#f4f4f4;font:200 1rem/1.3 "Noto Sans","DejaVu Sans",sans-serif;
 background:radial-gradient(95% 65% at 50% -12%,var(--bt,#4d4d4d),var(--bm,#1a1a1a) 55%,#000),#000}
body.wall{background:linear-gradient(#0006,#000b),url(../assets/wallpaper.jpg) center/cover,#000}
#bg{position:fixed;inset:0;width:100%;height:100%}
#ui{position:fixed;inset:0;transition:opacity .3s}
#ui::before{content:'';position:absolute;inset:0;pointer-events:none;background:radial-gradient(125% 100% at 50% 40%,transparent 50%,#000b),linear-gradient(#ffffff14,#fff0 16%)}
body.lg #bar,body.lg #list,body.lg #pane,body.lg footer,body.lg #crumb{opacity:0}

header{position:absolute;top:4vh;left:4vw;right:4vw;display:flex;justify-content:space-between;align-items:flex-start}
header::after{content:'';position:absolute;left:0;right:0;bottom:-1.3rem;height:1px;background:linear-gradient(90deg,transparent,rgb(var(--a)/.55),transparent)}
#brand{font-weight:200;font-size:1.5rem;letter-spacing:.65em;text-shadow:0 0 1rem rgb(var(--a)/calc(var(--g)*.7))}
#brand small{display:block;margin-top:.3rem;font-size:.6rem;letter-spacing:.3em;opacity:.45;text-transform:uppercase}
#clock{font-size:1.7rem;font-weight:200;letter-spacing:.08em;text-shadow:0 0 .9rem rgb(var(--a)/calc(var(--g)*.6))}

#bar{position:absolute;top:19vh;left:0;display:flex;transform:translateX(calc(24vw - (var(--i,0) + .5)*8rem));transition:transform .45s cubic-bezier(.2,.8,.2,1),opacity .3s}
.cat{position:relative;width:8rem;text-align:center;opacity:.34;transition:opacity .3s,transform .3s}
.cat.on{opacity:1;transform:scale(1.32)}
.cat.on::before{content:'';position:absolute;left:50%;top:-.8rem;width:7.5rem;height:7.5rem;transform:translateX(-50%);z-index:-1;background:radial-gradient(circle,rgb(var(--a)/calc(var(--g)*.3)),transparent 65%)}
.cat svg{width:3.1rem;height:3.1rem;stroke:#fff;fill:none;stroke-width:1.15;stroke-linecap:round;stroke-linejoin:round}
.cat.on svg{filter:drop-shadow(0 0 .6rem rgb(var(--a)/var(--g)));-webkit-box-reflect:below -.1rem linear-gradient(transparent 45%,#fff5)}
.cat span{display:block;height:1.3rem;margin-top:.35rem;font-size:.78rem;letter-spacing:.3em;opacity:0;transition:opacity .3s;text-shadow:0 0 .6rem rgb(var(--a)/calc(var(--g)*.8))}
.cat.on span{opacity:.95}
.sub #bar{opacity:.1}
#crumb{position:absolute;top:21vh;left:calc(24vw - 1.8rem);font-size:1rem;letter-spacing:.14em;opacity:.7}

#list{position:absolute;left:calc(24vw - 1.8rem);top:44vh;width:35vw;transition:transform .38s cubic-bezier(.2,.8,.2,1)}
.sw .it{animation:fi .45s backwards}
@keyframes fi{from{opacity:0;translate:0 1.2rem}}
.it{position:relative;height:4.6rem;display:flex;align-items:center;gap:1.1rem;transition:opacity .3s,transform .3s}
.it.on{transform:translateX(.8rem)}
.it.on::before{content:'';position:absolute;inset:.35rem -2rem .35rem -1.2rem;border-radius:3rem;z-index:-1;background:linear-gradient(90deg,transparent,rgb(var(--a)/calc(var(--g)*.17)) 25%,transparent)}
.it.on::after{content:'';position:absolute;left:-1.2rem;right:-3rem;bottom:.2rem;height:1px;background:linear-gradient(90deg,transparent,rgb(var(--a)/.85) 30%,transparent)}
.ic{flex:none;width:3.1rem;height:3.1rem;display:grid;place-items:center;overflow:hidden;font-style:normal;font-size:1.2rem;font-weight:200;border-radius:.7rem;
 border:1px solid #ffffff5c;background:var(--gloss);box-shadow:inset 0 1px 0 #fff8,0 .3rem .8rem #0006;transition:transform .3s}
.ic img{width:100%;height:100%;object-fit:cover}
.on .ic{transform:scale(1.12);border-color:#fffd;box-shadow:0 0 1.4rem rgb(var(--a)/calc(var(--g)*.65)),inset 0 1px 0 #fff}
.tx{flex:1;min-width:0}
.tx b{display:block;font-weight:200;font-size:1.35rem;letter-spacing:.03em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.on .tx b{font-weight:300;text-shadow:0 0 1rem rgb(var(--a)/calc(var(--g)*.9))}
.tx small{display:block;font-size:.82rem;opacity:.5;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.v{font-size:.95rem;opacity:.85;white-space:nowrap}
.ed .v{outline:1px solid #fff;border-radius:2rem;padding:.25rem .8rem}
.sl{display:inline-block;width:7rem;height:.3rem;border-radius:1rem;background:#fff3;vertical-align:middle;margin-right:.6rem}
.sl span{display:block;height:100%;border-radius:1rem;background:linear-gradient(90deg,rgb(var(--a)/.5),#fff)}
em.m{font-style:normal;font-size:.58rem;letter-spacing:.1em;border:1px solid #fff6;border-radius:1rem;padding:0 .4rem;opacity:.55}
body[data-is="1"] .ic{background:none;box-shadow:none}
body[data-is="2"] .ic{border-radius:50%}
body.noart #pane{display:none}

#pane{position:absolute;left:63vw;top:33vh;width:30vw}
.art{position:relative;overflow:hidden;aspect-ratio:16/9;display:grid;place-items:center;font-size:5rem;font-weight:100;margin-bottom:1.2rem;border-radius:.6rem;
 box-shadow:0 0 0 1px #fff6,0 1rem 3rem #000c;text-shadow:0 0 1.5rem #fff8;-webkit-box-reflect:below .5rem linear-gradient(transparent 72%,#fff3)}
.art img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.art::after{content:'';position:absolute;inset:0;background:linear-gradient(115deg,#fff6,#fff0 42%)}
#pane h2{font-weight:200;font-size:1.7rem;letter-spacing:.04em;margin:1.6rem 0 .5rem;text-shadow:0 0 1rem rgb(var(--a)/calc(var(--g)*.6))}
#pane p{opacity:.6;line-height:1.5}

footer{position:absolute;left:4vw;right:4vw;bottom:3.5vh;display:flex;justify-content:space-between;align-items:center;padding-top:.9rem;font-size:.8rem;letter-spacing:.08em;border-top:1px solid #fff2}
#hints,#np{opacity:.55}
#who{display:flex;align-items:center;gap:.7rem;font-size:.95rem;letter-spacing:.1em}
.wa{width:2.1rem;height:2.1rem;border-radius:50%;overflow:hidden;border:1px solid #fffa;box-shadow:0 0 .8rem rgb(var(--a)/calc(var(--g)*.5))}
.wa img{width:100%;height:100%;object-fit:cover}

#modal,#black{position:fixed;inset:0;display:none;place-items:center;background:#000c}
#modal{z-index:6}#toast{z-index:7}
#black{z-index:9;background:#000;text-align:center;white-space:pre-line;opacity:.5;font-weight:200;letter-spacing:.15em}
.box{min-width:30rem;max-width:44rem;padding:2.6rem 3rem;text-align:center;border-radius:.9rem;border:1px solid #fff5;
 background:linear-gradient(180deg,#ffffff26 0,#ffffff0a 49%,#00000040 50%),#0e1216f2;box-shadow:0 0 5rem #000,inset 0 1px 0 #fff6}
.box h2{font-weight:200;font-size:1.8rem;margin-bottom:.8rem}
.box p{opacity:.7}
.box code{display:block;margin-top:1rem;padding:.6rem 1rem;border-radius:.4rem;background:#000;font:.85rem monospace;opacity:.85}
.btns{display:flex;gap:1rem;justify-content:center;margin-top:2rem}
.btn{padding:.6rem 2.2rem;border-radius:2rem;border:1px solid #fff5;background:var(--gloss);opacity:.65}
.btn.on{opacity:1;color:#000;background:linear-gradient(180deg,#fff,#cfd6dc);box-shadow:0 0 1.4rem rgb(var(--a)/.9)}
#toast{position:fixed;top:11vh;right:4vw;padding:.7rem 1.5rem;border-radius:2rem;border:1px solid #fff5;background:linear-gradient(180deg,#ffffff26,#00000040),#0e1216f2;opacity:0;transition:opacity .3s;pointer-events:none}
#toast.on{opacity:1}
.rm *{transition-duration:0s!important;animation:none!important}

/* boot */
#boot{position:fixed;inset:0;z-index:20;display:grid;place-items:center;background:#000;transition:opacity 1s}
#boot.off{opacity:0;pointer-events:none}
#boot span{font-weight:100;font-size:3.4rem;text-indent:.9em;text-shadow:0 0 2rem #fff9;animation:bt 3.4s ease-out both}
@keyframes bt{from{opacity:0;letter-spacing:.2em}35%{opacity:1}to{opacity:1;letter-spacing:.9em}}

/* sign-in: carousel of avatars, picker, keyboard, keypad */
#login{position:fixed;inset:0;z-index:5;display:none;place-items:center;text-align:center;background:radial-gradient(70% 60% at 50% 48%,#0000,#000a)}
#login.over{background:#000d}
.lgi{width:100vw}
#login h1{font-weight:100;font-size:2.3rem;letter-spacing:.35em;text-indent:.35em;margin-bottom:2.6rem;text-shadow:0 0 1.4rem rgb(var(--a)/calc(var(--g)*.7))}
#login .msg{min-height:1.6rem;margin:.8rem 0;opacity:.7}
.lh{position:fixed;left:0;right:0;bottom:3.5vh;font-size:.8rem;letter-spacing:.12em;opacity:.45}
.fld{display:inline-block;min-width:26rem;min-height:3.6rem;padding:.6rem 1.5rem;font-size:1.8rem;letter-spacing:.12em;border-bottom:1px solid #fffa}
.rows{display:flex;flex-direction:column;gap:.5rem;align-items:center;margin-top:1rem}
.row{display:flex;gap:.5rem;justify-content:center}
.k{display:grid;place-items:center;min-width:3.4rem;height:3.4rem;padding:0 1rem;border-radius:.7rem;cursor:pointer;border:1px solid #fff4;background:var(--gloss);opacity:.62;transition:opacity .2s,box-shadow .2s,transform .25s}
.k.w{min-width:6.5rem}
.k.pin{min-width:0;width:4.6rem;height:4.6rem;padding:0;border-radius:50%;font-size:1.4rem}
.k.on{opacity:1;border-color:#fffd;box-shadow:0 0 1.3rem rgb(var(--a)/calc(var(--g)*.7)),inset 0 1px 0 #fff}
.rows.car{width:100vw;overflow:hidden;-webkit-mask-image:linear-gradient(90deg,transparent,#000 22%,#000 78%,transparent)}
.rows.car .row{flex-wrap:nowrap;width:max-content;gap:0;padding:2.5rem calc(50vw - 8rem) 4rem}
.rows.pk{max-height:25rem;overflow:hidden;gap:1.2rem;padding:1.5rem 0}
.rows.pk .row{gap:1.2rem}
.k.t,.k.pf{height:auto;min-width:0;padding:0;border:0;background:none;box-shadow:none;border-radius:0;flex-direction:column;display:flex;align-items:center}
.k.t{width:16rem;gap:1.3rem;opacity:.45;transform:scale(.82)}
.k.pf{opacity:.6;transform:scale(.9)}
.k.t.on{opacity:1;transform:scale(1.22);box-shadow:none}
.k.pf.on{opacity:1;transform:scale(1.18);box-shadow:none}
.k.t b{font-weight:200;font-size:1.35rem;letter-spacing:.14em}
.av2{width:8.5rem;height:8.5rem;border-radius:50%;overflow:hidden;display:grid;place-items:center;font-size:3.4rem;font-weight:100;border:2px solid #fff5;background:linear-gradient(155deg,#ffffff33,#ffffff08);
 -webkit-box-reflect:below .5rem linear-gradient(transparent 62%,#fff3)}
.k.pf .av2{width:6rem;height:6rem}
.av2 img{width:100%;height:100%;object-fit:cover}
.on .av2{border-color:#fff;box-shadow:0 0 0 .4rem rgb(var(--a)/.25),0 0 3rem rgb(var(--a)/calc(var(--g)*.75))}
.wl{display:flex;flex-direction:column;align-items:center;gap:2rem}.wl h1{margin:0}
